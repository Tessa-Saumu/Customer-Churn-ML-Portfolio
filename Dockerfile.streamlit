# Aligned with the supported runtime (Python 3.11) on 2026-10-05. This optional
# demo image was not built or run here -- see docs/reproduction_record.md.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt requirements.lock.txt ./

RUN pip install --no-cache-dir -r requirements.txt \
    && rm -rf /root/.cache/pip

COPY streamlit-app.py .

EXPOSE 8501

CMD ["streamlit", "run", "streamlit-app.py", "--server.address=0.0.0.0", "--server.port=8501"]